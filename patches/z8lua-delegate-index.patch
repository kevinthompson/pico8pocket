Preserve the hot lookup calling convention; delegate only at a cold boundary.

diff --git a/lvm.c b/lvm.c
--- a/lvm.c
+++ b/lvm.c
@@ -136,7 +136,7 @@
     else if (ttisnil(tm = luaT_gettmbyobj(L, t, TM_INDEX)))
       luaG_typeerror(L, t, "index");
     if (ttisfunction(tm)) {
-      callTM(L, tm, t, key, val, 1);
+      luaV_callindex(L, tm->value_, tm->tt_, t, key, val, 1);
       return;
     }
     t = tm;  /* else repeat with 'tm' */
