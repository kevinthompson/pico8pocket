Snapshot the callback before an allocation-free delegate guard.

diff --git a/lvm.c b/lvm.c
--- a/lvm.c
+++ b/lvm.c
@@ -92,6 +92,18 @@

 static void callTM (lua_State *L, const TValue *f, const TValue *p1,
                     const TValue *p2, TValue *p3, int hasres) {
+  /* Consume the callback before the opaque, allocation-free guard. Keeping
+     the original TValue live across that call prevents scalar IPA splitting. */
+  TValue callback;
+  setobj(L, &callback, f);
+  f = &callback;
+  if (hasres && ttisLclosure(f)) {
+    const TValue *value = luaV_delegateclosure(L, clLvalue(f), p1, p2);
+    if (value != NULL) {
+      setobj2s(L, p3, value);
+      return;
+    }
+  }
   ptrdiff_t result = savestack(L, p3);
   setobj2s(L, L->top++, f);  /* push function */
   setobj2s(L, L->top++, p1);  /* 1st argument */
