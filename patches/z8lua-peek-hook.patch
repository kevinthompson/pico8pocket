+  lu_byte const *pico8peekdirty;  /* nonzero while the window is stale */
+  unsigned short const *pico8peekbase;  /* start of the 0x2000-byte window */
+  lua_Pico8PeekHook pico8peekhook;  /* brings RAM up to date for a peek */
   struct lua_State *mainthread;
