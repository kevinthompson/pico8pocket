 LUA_API void  (lua_setpico8memory) (lua_State *L, unsigned char const *p);
+/* While *dirty is nonzero, the @, % and $ operators call
+ * hook(L, address, count) before a read that overlaps the 0x2000 bytes at
+ * *base, so a host that keeps that memory elsewhere (such as the screen)
+ * can copy it back first. */
+typedef void (*lua_Pico8PeekHook) (lua_State *L, int address, int count);
+LUA_API void  (lua_setpico8peekhook) (lua_State *L,
+                                      unsigned char const *dirty,
+                                      unsigned short const *base,
+                                      lua_Pico8PeekHook hook);
 
