+/*
+** Pico8Pocket: __index chain cache.
+**
+** Objects built as metatable classes (an instance whose metatable is its
+** class, each class falling back to its parent through __index) look up
+** inherited fields, methods and missing names by walking the whole chain:
+** two hash lookups per level (the key, then "__index" in the next
+** metatable).  PICO-8 itself charges such a read like a plain one.
+**
+** An entry is keyed by the key's text and the receiver's metatable, so
+** every instance of a class shares it.  It records the tables the result
+** depended on -- each metatable whose __index was followed and each table
+** the key was absent from -- and the final table: where the key was found,
+** or the end of the chain.  A hit checks that every recorded table still
+** has CHAIN_VALID (no write, new key, resize or setmetatable since) and
+** then looks the key up in the final table only, so changes to the final
+** table (typically the globals) never retire the entry.  Chains with
+** __index functions, non-table __index values, keys longer than
+** CHAIN_MAXKEY bytes or more than CHAIN_MAXTABLES links are not cached and
+** take luaV_gettable's normal walk.
+**
+** Recorded tables stay alive while the entry is valid: each is reachable
+** from the receiver's metatable through tables that have not changed, and
+** the receiver's metatable is the first recorded table.  The key is
+** compared by its text, not its address, so a string freed and replaced at
+** the same address cannot match a stale entry.
+*/
+#define CHAIN_ENTRIES	128
+#define CHAIN_MAXTABLES	32
+#define CHAIN_MAXKEY	16
+
+typedef struct ChainEntry {
+  Table *metatable;  /* the receiver's metatable; NULL: empty entry */
+  lu_int32 keylen;
+  lu_int32 key[CHAIN_MAXKEY / 4];  /* the key's text, zero-padded */
+  Table *final;  /* where the key was found, or where the chain ended */
+  int count;  /* tables in 'tables'; -1: chain not cacheable */
+  Table *tables[CHAIN_MAXTABLES];
+} ChainEntry;
+
+
+void luaV_freechaincache (global_State *g) {
+  if (g->chaincache)
+    (*g->frealloc)(g->ud, g->chaincache,
+                   CHAIN_ENTRIES * sizeof(ChainEntry), 0);
+  g->chaincache = NULL;
+}
+
+
+static __attribute__((noinline)) ChainEntry *chainalloc (global_State *g) {
+  /* Outside the GC's accounting, like the main state block. */
+  g->chaincache = cast(ChainEntry *,
+      (*g->frealloc)(g->ud, NULL, 0, CHAIN_ENTRIES * sizeof(ChainEntry)));
+  if (g->chaincache != NULL)
+    memset(g->chaincache, 0, CHAIN_ENTRIES * sizeof(ChainEntry));
+  return g->chaincache;
+}
+
+
+static inline ChainEntry *chainentry (lua_State *L, TString *key, Table *mt) {
+  global_State *g = G(L);
+  ChainEntry *cache = g->chaincache;
+  size_t slot = key->tsv.hash ^ ((size_t)mt >> 5);
+  if (cache == NULL && (cache = chainalloc(g)) == NULL) return NULL;
+  return &cache[slot & (CHAIN_ENTRIES - 1)];
+}
+
+
+/* Whether the entry's key has the same text as 'key', whose length
+** 'len' (at most CHAIN_MAXKEY) already matches.  String text is word
+** aligned; the bytes after the last whole word are compared one by one. */
+static inline int chainkeyequal (const ChainEntry *e, const TString *key,
+                                 size_t len) {
+  const char *text = cast(const char *,
+                          __builtin_assume_aligned(getstr(key), 4));
+  const char *saved = cast(const char *, e->key);
+  size_t i;
+  for (i = 0; i + 4 <= len; i += 4) {
+    lu_int32 a, b;
+    memcpy(&a, text + i, 4);
+    memcpy(&b, saved + i, 4);
+    if (a != b) return 0;
+  }
+  for (; i < len; i++)
+    if (text[i] != saved[i]) return 0;
+  return 1;
+}
+
+
+static void chainrecord (ChainEntry *e, int *count, Table *t) {
+  if (*count == 0 || e->tables[*count - 1] != t)  /* a class is often its */
+    e->tables[(*count)++] = t;                    /* own __index */
+}
+
+
+/*
+** Walk the __index chain from metatable 'mt' (of a table that lacks 'key')
+** and record it in 'e'.  Returns the value, or NULL when only
+** luaV_gettable's general walk can answer.
+*/
+static __attribute__((noinline))
+const TValue *chainrefill (lua_State *L, ChainEntry *e, Table *mt,
+                           TString *key, size_t keylen) {
+  const TValue *res;
+  int count = 0, i;
+  Table *t = NULL;  /* the table whose metatable is 'mt' (none at first) */
+  e->metatable = mt;
+  e->keylen = cast(lu_int32, keylen);
+  memset(e->key, 0, sizeof(e->key));
+  memcpy(e->key, getstr(key), keylen);
+  e->count = -1;
+  for (;;) {
+    const TValue *tm = fasttm(L, mt, TM_INDEX);
+    if (tm == NULL) {
+      if (t == NULL) {  /* no __index at all: nothing to cache */
+        e->metatable = NULL;
+        return luaO_nilobject;
+      }
+      res = luaO_nilobject;
+      break;  /* the chain ends at 't' */
+    }
+    if (!ttistable(tm) || count + 2 > CHAIN_MAXTABLES) return NULL;
+    if (t != NULL) chainrecord(e, &count, t);  /* key absent there */
+    chainrecord(e, &count, mt);  /* its __index was followed */
+    t = hvalue(tm);
+    res = luaH_getstr(t, key);
+    if (!ttisnil(res)) break;  /* found in 't' */
+    mt = t->metatable;
+    if (mt == NULL) break;  /* the chain ends at 't' */
+  }
+  for (i = 0; i < count; i++)
+    e->tables[i]->flags |= CHAIN_VALID;
+  e->final = t;
+  e->count = count;
+  return res;
+}
+
+
+/*
+** The value of 'key' read through table 'h', for a short-string key: an
+** entry of 'h' itself, or what the __index chain gives.  Returns NULL when
+** only luaV_gettable's general walk can answer (an __index function, an
+** uncacheable chain, or a chain that changed past the final table).
+*/
+static inline const TValue *luaV_chainget (lua_State *L, Table *h,
+                                           TString *key) {
+  const TValue *res = luaH_getstr(h, key);
+  Table *mt = h->metatable;
+  size_t keylen = key->tsv.len;
+  ChainEntry *e;
+  int i;
+  if (!ttisnil(res) || mt == NULL) return res;
+  if (keylen > CHAIN_MAXKEY) return NULL;
+  e = chainentry(L, key, mt);
+  if (e == NULL) return NULL;
+  if (e->metatable != mt || e->keylen != keylen ||
+      !chainkeyequal(e, key, keylen))
+    return chainrefill(L, e, mt, key, keylen);
+  if (e->count < 0) return NULL;
+  for (i = 0; i < e->count; i++)
+    if (!(e->tables[i]->flags & CHAIN_VALID))
+      return chainrefill(L, e, mt, key, keylen);
+  res = luaH_getstr(e->final, key);
+  if (!ttisnil(res) || fasttm(L, e->final->metatable, TM_INDEX) == NULL)
+    return res;
+  return NULL;  /* the final table now continues the chain */
+}
+
