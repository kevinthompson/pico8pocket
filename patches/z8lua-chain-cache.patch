+++ b/ltable.h
@@ -17,6 +17,16 @@
 
 #define invalidateTMcache(t)	((t)->flags = 0)
 
+/*
+** Pico8Pocket: bit 7 of 'flags' (above the cached tag methods) marks a
+** table that an __index chain-cache entry relies on.  It is set when the
+** chain is walked and cleared by anything that could change a lookup
+** through the table: every write clears 'flags', and new keys, resizes and
+** setmetatable clear it explicitly.  See luaV_chainget.
+*/
+#define CHAIN_VALID	0x80u
+#define invalidatechain(t)	((t)->flags &= cast_byte(~CHAIN_VALID))
+
 /* returns the key, given the value of a table entry */
 #define keyfromval(v) \
   (gkey(cast(Node *, cast(char *, (v)) - offsetof(Node, i_val))))
